# Finder metadata
.DS_Store

# SwiftPM's intermediate build directory and the assembled app bundle. Both are
# generated; released builds are published to GitHub Releases by
# .github/workflows/release.yml, so there is nothing to gain from committing a
# binary that changes on every feature commit.
/.build/
/build/

# Agent-to-agent handoff notes. Local scratch for whoever picks the work up next;
# it describes uncommitted state, so it is never useful in a commit. Written only
# on request — see .claude/skills/handoff/SKILL.md.
/handoff.md

# Per-machine Claude Code permissions. The skills alongside it are meant to be
# shared; this one is not.
/.claude/settings.local.json
